# PostgreSQL must be installed and running locally before starting BizScopeAI.
DATABASE_URL=postgresql+psycopg://bizscope:change-me@127.0.0.1:5432/bizscopeai

# Ollama must be running locally with these models pulled.
BIZSCOPE_OLLAMA_URL=http://127.0.0.1:11434/api/chat
BIZSCOPE_GENERAL_MODEL=gemma3:4b
BIZSCOPE_PLANNER_MODEL=qwen3:4b
BIZSCOPE_OLLAMA_TIMEOUT_SECONDS=300
BIZSCOPE_OLLAMA_CONNECT_TIMEOUT_SECONDS=5
BIZSCOPE_LLM_MAX_RETRIES=1
BIZSCOPE_LLM_NUM_CTX=8192
BIZSCOPE_LLM_MAX_OUTPUT_TOKENS=768

# Persistent local application data. Defaults to <project>/dataset/uploads.
BIZSCOPE_DATA_DIR=./dataset/uploads
BIZSCOPE_MAX_UPLOAD_MB=50

# Streamlit frontend defaults to the local FastAPI backend.
BIZSCOPE_API_URL=http://127.0.0.1:8000
